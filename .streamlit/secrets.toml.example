# The hosted demo's secrets (D3.2): names only. Paste the real values into the host's secret
# store (Streamlit Community Cloud: app settings, Secrets), never into this repo. A local
# .streamlit/secrets.toml is git-ignored. See docs/deploy.md for how to make each value.

# required: the app shows only a locked page while any of these is missing
OPENAI_API_KEY = ""          # a key of the separate demo OpenAI project (hard spend limit)
DEMO_PASSKEY_HASH = ""       # learner passcode hash from `course-assistant passkey-hash`
STAFF_PASSKEY_HASH = ""      # teaching-team passcode hash; must differ from the learner one
DEMO_KV_REST_URL = ""        # hosted KV (Redis over REST) for the daily spend counter
DEMO_KV_REST_TOKEN = ""      # its token
PID_SECRET = ""              # random secret for pseudonymous ids (Tech Spec §8)

# optional
DEMO_TRUSTED_PROXY_HOPS = "" # proxy hops to trust in X-Forwarded-For; empty or 0 trusts none
